{
  "name": "designstocker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "next dev -p 3000",
    "dev:api": "node server/index.js",
    "build": "next build",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "start:web": "next start -p 3000",
    "start:api": "node server/index.js",
    "lint": "next lint"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.3.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.6",
    "razorpay": "^2.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^22.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.6"
  }
}
